<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -Indexes

    # Keep application internals and local configuration out of the web.
    RewriteRule ^(core|controllers|models|views|database|config)(/|$) - [F,NC,L]

    # Serve existing public assets and uploaded files directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route application URLs through the root entry point.
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>
